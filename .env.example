PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TOOL=spatial_omics_copilot
PUBMED_CHROMA_DIR=data/pubmed_chroma

# DeepInfra LLM provider (optional; the app defaults to local Ollama).
# Set this to deepinfra to make DeepInfra the default chat provider.
LLM_PROVIDER=ollama
# DeepInfra's docs call this token DEEPINFRA_TOKEN; either name works.
DEEPINFRA_API_KEY=
# Overrides deepinfra.model in config/app.yaml. Use a vision-capable model
# (e.g. Qwen/Qwen2.5-VL-7B-Instruct) if you want the cropped ROI image sent.
DEEPINFRA_MODEL=
